generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  roles    Role[]
  courses  Course[]
  classes  Class[]
}

model Role {
  id    String @id @default(cuid())
  name  String @unique // "admin", "hod", "teacher"
  users User[]
}

model Course {
  id             String         @id @default(cuid())
  name           String         @unique // e.g. "11CS", "CP"
  subject        String?        // e.g. "Computer Science"
  studiedComment String? // Intro text
  classes        Class[]
  commentGroups  CommentGroup[]
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id])
}

model Class {
  id       String    @id @default(cuid())
  name     String    @unique // e.g. "7CP"
  year     String?   // e.g. "7", "8"
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students Student[]
  teachers User[]
}

model Student {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  gender    String // "Male", "Female"
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Codes (e.g. "H", "M", "L")
  wpCode String?
  thCode String?
  psCode String?
  oaCode String?

  // Levels
  eoyLevel    String?
  targetLevel String?
  actualLevel String?

  comment String? // The final editable comment text
}

model CommentGroup {
  id           String          @id @default(cuid())
  name         String // "WP", "TH", "PS", "OA"
  displayOrder Int             @default(0)
  courseId     String
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options      CommentOption[]

  @@unique([courseId, name])
}

model CommentOption {
  id           String       @id @default(cuid())
  code         String // "H", "M", "L"
  text         String
  displayOrder Int          @default(0)
  groupId      String
  group        CommentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
}
