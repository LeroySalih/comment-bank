generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id           String      @id
  pupilId      String
  classId      String
  eoyLevel     String?
  targetLevel  String?
  actualLevel  String?
  finalComment String?

  // Comment Check Status
  checkStatus   String    @default("not_required")  // not_required | required_check | checked_ok | checked_rejected
  checkNote     String?                              // Feedback note from HoD (for rejections)
  checkedAt     DateTime?                            // When check decision was made
  checkedById   String?                              // User ID of HoD who checked

  Class        Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  Pupil        Pupil       @relation(fields: [pupilId], references: [admissionNumber], onDelete: Cascade)
  PupilCode    PupilCode[]
  CheckedBy    User?       @relation("CheckedAssignments", fields: [checkedById], references: [id])

  @@index([classId])
  @@index([pupilId])
  @@index([checkStatus])
}

model Class {
  id         String       @id
  name       String       @unique
  year       String?
  subjectId  String
  Assignment Assignment[]
  Subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  User       User[]

  @@index([subjectId])
}

model CommentGroup {
  id            String          @id
  name          String
  displayOrder  Int             @default(0)
  subjectId     String
  title         String          @default("")
  Subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  CommentOption CommentOption[]
  PupilCode     PupilCode[]

  @@unique([subjectId, name])
}

model CommentOption {
  id           String       @id
  code         String
  text         String
  displayOrder Int          @default(0)
  groupId      String
  CommentGroup CommentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
  @@index([groupId])
}

model Pupil {
  admissionNumber String       @id
  firstName       String
  lastName        String
  gender          String
  isActive        Boolean      @default(true)
  form            String?
  Assignment      Assignment[]
}

model PupilCode {
  id           String       @id
  assignmentId String
  groupId      String
  code         String?
  Assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  CommentGroup CommentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, groupId])
  @@index([assignmentId])
  @@index([groupId])
}

model Role {
  id   String @id
  name String @unique
  User User[]
}

model Subject {
  id             String         @id
  code           String         @unique
  title          String?
  studiedComment String?
  Class          Class[]
  CommentGroup   CommentGroup[]
  User           User[]
}

model User {
  id                  String       @id
  username            String       @unique
  password            String
  isActive            Boolean      @default(true)
  Class               Class[]
  Role                Role[]
  Subject             Subject[]
  CheckedAssignments  Assignment[] @relation("CheckedAssignments")
}

model Deadline {
  id          String   @id
  title       String
  date        DateTime
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id
  userId      String?
  username    String?
  action      String   // e.g., "sign_in", "sign_out", "update_pupil", "update_comment"
  entityType  String?  // e.g., "user", "pupil", "assignment", "comment"
  entityId    String?  // ID of the affected entity
  details     String?  // JSON string with before/after values and additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
