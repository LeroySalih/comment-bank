generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  roles    Role[]
  subjects Subject[]
  classes  Class[]
}

model Role {
  id    String @id @default(cuid())
  name  String @unique // "admin", "hod", "teacher"
  users User[]
}

model Subject {
  id             String         @id @default(cuid())
  name           String         @unique // e.g. "11CS", "CP"
  subject        String?        // e.g. "Computer Science"
  studiedComment String? // Intro text
  classes        Class[]
  commentGroups  CommentGroup[]
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id])
}

model Class {
  id          String       @id @default(cuid())
  name        String       @unique // e.g. "7CP"
  year        String?      // e.g. "7", "8"
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  teachers    User[]
}

model Pupil {
  admissionNumber String       @id
  firstName       String
  lastName        String
  gender          String       // "Male", "Female"
  isActive        Boolean      @default(true)
  assignments     Assignment[]
}

model Assignment {
  id        String @id @default(cuid())
  pupilId   String
  pupil     Pupil  @relation(fields: [pupilId], references: [admissionNumber], onDelete: Cascade)
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Levels
  eoyLevel    String?
  targetLevel String?
  actualLevel String?

  finalComment String? // The final editable comment text
  codes        PupilCode[]
}

model PupilCode {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId      String
  group        CommentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code         String?      // The selected code (e.g. "H", "M", "L")

  @@unique([assignmentId, groupId])
}

model CommentGroup {
  id           String          @id @default(cuid())
  name         String // "WP", "TH", "PS", "OA"
  displayOrder Int             @default(0)
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options      CommentOption[]
  pupilCodes   PupilCode[]

  @@unique([subjectId, name])
}

model CommentOption {
  id           String       @id @default(cuid())
  code         String // "H", "M", "L"
  text         String
  displayOrder Int          @default(0)
  groupId      String
  group        CommentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
}
